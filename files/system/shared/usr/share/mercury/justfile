# Recipes behind the `mercury` command.
# Ported from neptuno; rpm-ostree calls rewritten for bootc (composefs —
# there is no RPM database on this image).

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --justfile {{ justfile() }} --list

# Show the image, deployments, power profile and hibernate state
info:
    jq . /usr/share/mercury/image-info.json 2>/dev/null || true
    bootc status --json 2>/dev/null | jq '.status | {booted: .booted.image.image, staged: .staged.image.image, rollback: .rollback.image.image}' 2>/dev/null || bootc status || true
    powerprofilesctl get 2>/dev/null || true
    echo "CanHibernate: $(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager CanHibernate 2>/dev/null || echo unknown)"
    echo "Lockdown: $(cat /sys/kernel/security/lockdown 2>/dev/null || echo unknown)"

# Show what an update (or a rollback) would switch to: image refs and digests.
# There is no RPM database to diff package-by-package; the image is the unit.
changelog:
    #!/usr/bin/bash
    bootc status --json | jq -r '
      .status as $s |
      "booted:   \($s.booted.image.image.image // "none")  (\($s.booted.image.imageDigest // $s.booted.image.image.digest // "?"))",
      "staged:   \($s.staged.image.image.image // "none")  (\($s.staged.image.imageDigest // "?"))",
      "rollback: \($s.rollback.image.image.image // "none")  (\($s.rollback.image.imageDigest // "?"))"
    ' 2>/dev/null || bootc status

# Compare your niri and ghostty configs with the image's reference stubs
config-diff:
    #!/usr/bin/bash
    for pair in niri/config.kdl ghostty/config topgrade.toml; do
        echo "== ${pair}"
        diff -u "/etc/skel/.config/${pair}" "${HOME}/.config/${pair}" || true
    done

# Put the image's default config back for an app (niri, dms, ghostty, topgrade, or all); yours is kept as <name>.bak-<time>
refresh-config app:
    #!/usr/bin/bash
    set -euo pipefail
    skel=/etc/skel/.config
    mapfile -t known < <(find "${skel}" -mindepth 1 -maxdepth 1 ! -type l -printf '%f\n' | sed 's/\.toml$//' | sort)
    if [[ "{{ app }}" == all ]]; then
        apps=("${known[@]}")
    elif printf '%s\n' "${known[@]}" | grep -qx -- "{{ app }}"; then
        apps=("{{ app }}")
    else
        echo "Unknown app '{{ app }}'. Choose one of: ${known[*]} all" >&2
        exit 1
    fi
    stamp="$(date +%Y%m%d-%H%M%S)"
    for app in "${apps[@]}"; do
        name="${app}"; [[ -e "${skel}/${name}" ]] || name="${app}.toml"
        target="${HOME}/.config/${name}"
        if [[ -e "${target}" ]]; then
            backup="${target}.bak-${stamp}"; n=1
            while [[ -e "${backup}" ]]; do backup="${target}.bak-${stamp}-$((n++))"; done
            mv "${target}" "${backup}"
            echo "Saved your ${name} as ${backup}"
        fi
        cp -a "${skel}/${name}" "${target}"
        echo "Restored ${name} from the image defaults"
    done

# Collect a diagnostic bundle for filing an issue (hardware, image, failed
# units, journal errors). Nothing sensitive is collected; review the tarball
# before attaching it.
report:
    #!/usr/bin/bash
    set -euo pipefail
    stamp="$(date +%Y%m%d-%H%M%S)"
    out="${HOME}/mercury-report-${stamp}"
    mkdir -p "${out}"
    {
      echo '=== os-release ==='; cat /etc/os-release
      echo; echo '=== image-info ==='; cat /usr/share/mercury/image-info.json 2>/dev/null || true
      echo; echo '=== bootc status ==='; bootc status 2>&1 || true
      echo; echo '=== fastfetch ==='; fastfetch --structure os:kernel:de:wm:cpu:gpu:memory:disk:battery 2>/dev/null || fastfetch 2>/dev/null || true
      echo; echo '=== failed units ==='; systemctl --failed --no-legend 2>/dev/null || true
      echo; echo '=== degraded? ==='; systemctl is-system-running 2>/dev/null || true
    } > "${out}/summary.txt" 2>&1
    journalctl -b -p err --no-pager > "${out}/journal-errors.txt" 2>&1 || true
    journalctl -b -u greetd.service -u niri.service --no-pager > "${out}/session.txt" 2>&1 || true
    dmesg --level=err,warn > "${out}/dmesg.txt" 2>&1 || dmesg > "${out}/dmesg.txt" 2>&1 || true
    tar -C "${HOME}" -cf "${out}.tar.zst" --zstd "mercury-report-${stamp}"
    echo "Report: ${out}.tar.zst"
    if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
        echo; head -40 "${out}/summary.txt"
        read -r -p "File this as a GitHub issue? [y/N] " ans || ans=""
        if [[ "${ans}" =~ ^[yY] ]]; then
            read -r -p "Title: " title
            gist_url="$(gh gist create --desc "mercury-report-${stamp}" "${out}.tar.zst" 2>/dev/null || true)"
            body="${gist_url:-tarball: ${out}.tar.zst}"
            body+=$'\n\n```\n'; body+="$(cat "${out}/summary.txt")"; body+=$'\n```'
            gh issue create --title "${title:-mercury report ${stamp}}" --body "${body}" --label needs-triage
        fi
    else
        echo "File at https://github.com/siddhj2206/mercury/issues/new and attach it."
    fi
    rm -rf "${out}"

# Hardware fingerprint for issue comments; shared by confirm and verify.
[private]
_hw-fingerprint:
    #!/usr/bin/bash
    {
      echo "### Hardware fingerprint"
      fastfetch 2>/dev/null | head -10 || true
      echo
      echo '```'
      grep -E 'PRETTY_NAME|IMAGE_VERSION|IMAGE_ID' /etc/os-release 2>/dev/null
      bootc status --json 2>/dev/null | jq -r '.status.booted.image.imageDigest // empty' | sed 's/^/digest: /'
      echo '```'
    }

# Add a hardware fingerprint to an existing issue — same bug, different
# hardware, no duplicate filing.
confirm issue:
    #!/usr/bin/bash
    set -euo pipefail
    just --justfile "{{ justfile() }}" _hw-fingerprint | gh issue comment "{{ issue }}" --body-file -
    echo "Fingerprint added to issue {{ issue }}"

# `mercury verify` checks the booted image's cosign signature.
# `mercury verify <issue>` posts a works-on-latest attestation on that
# issue after a fix ships — evidence, not vibes.
verify issue="":
    #!/usr/bin/bash
    set -euo pipefail
    if [[ -n "{{ issue }}" ]]; then
      {
        echo "### Verified on :latest"
        bootc status --json 2>/dev/null | jq -r '.status.booted.image.image.image // "unknown"' | sed 's/^/image: /'
        just --justfile "{{ justfile() }}" _hw-fingerprint
      } | gh issue comment "{{ issue }}" --body-file -
      echo "Verification posted to issue {{ issue }}"
      exit 0
    fi
    name="$(bootc status --json | jq -r '.status.booted.image.image.image' | sed 's|.*docker://||')"
    digest="$(bootc status --json | jq -r '.status.booted.image.imageDigest // .status.booted.image.image.digest')"
    repo="$(jq -r '."image-name"' /usr/share/mercury/image-info.json)"
    vendor="$(jq -r '."image-vendor"' /usr/share/mercury/image-info.json)"
    echo "Verifying ${name}@${digest}"
    # GitHub keeps the owner's capitalisation in the certificate; image names
    # are lowercase, so match case-insensitively.
    podman run --rm ghcr.io/sigstore/cosign/cosign:v3.1.4@sha256:0f06154836d2de34f887a5c273506d52ca43edaa1d9e53e6510fa78a48f69c2d verify \
        --certificate-identity-regexp "(?i)^https://github\\.com/${vendor}/${repo}/\\.github/workflows/build\\.yml@refs/heads/main\$" \
        --certificate-oidc-issuer https://token.actions.githubusercontent.com \
        "${name}@${digest}" >/dev/null
    echo "Signature OK"
