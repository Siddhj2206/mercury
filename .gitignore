# Ignore Python local cache across repo
**/__pycache__/

# Debug session artifacts
debug-session/

# Ignore BuildStream local state
.bst
.bst2
.cache/*

*.img
*.raw
*.tar
.ovmf-vars.fd
.build-out
.build-ownership/
.build-ownership-source/

# Git worktrees
.worktrees/
files/xattr-db/
files/fakecap/fakecap-restore
files/fakecap/fakecap.so

# Secure Boot signing key, written by CI or just secure-boot-keygen
files/boot-keys/private/*
!files/boot-keys/private/.keep

# scripts/update_sources.py stages patched sources here to check them.
/.source-check/

# Local build/boot-test outputs
.build-logs/
bootable.qcow2

# just install-test outputs
install-test.raw
install-test-serial.log
install-test-vars.fd
